# BRETHOF BRAIN — the hub, as the customer runs it (2026-11-17, local-first).
# Build context: the repository root.
#
# The gate (the licence and device module) ships COMPILED: gate/<arch>/ holds
# one Nuitka-built native module per chip type. Its source is not public, and
# the hub never needs it: Python imports the .so directly.
FROM docker.io/library/python:3.12-slim
ARG TARGETARCH
RUN pip install --no-cache-dir fastapi==0.115.12 "uvicorn[standard]==0.34.2" \
      websockets==15.0.1 httpx==0.28.1 cryptography==45.0.7 \
      python-multipart==0.0.20
WORKDIR /app
COPY hub/ hub/
COPY core/__init__.py core/__init__.py
COPY core/prompts.py core/prompts.py
COPY core/inference.py core/inference.py
COPY core/brieftext.py core/brieftext.py
COPY core/composer.py core/composer.py
# B+v3's question parsing (2026-11-17): the composer imports it on every prompt
COPY core/recallq.py core/recallq.py
COPY gate/${TARGETARCH}/gate*.so /app/
RUN find /app -name '__pycache__' -type d -prune -exec rm -rf {} + ; \
    test ! -e /app/gate/__init__.py
RUN useradd -r -u 900 hub && mkdir -p /srv/hub && chown hub:hub /srv/hub
USER hub
ENV PYTHONDONTWRITEBYTECODE=1 HUB_DB_PATH=/srv/hub/hub.sqlite GATE_DB_PATH=/srv/hub/gate.sqlite \
    HUB_ADMIN_TOKEN_FILE=/srv/hub/admin-token
EXPOSE 8600
CMD ["python", "-m", "hub.local"]
